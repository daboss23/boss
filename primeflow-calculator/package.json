{
  "name": "primeflow-profit-recovery-engine",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && wrangler pages dev dist --d1 DB --compatibility-date=2025-09-01",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply primeflow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply primeflow-db --remote",
    "leads:export": "node scripts/leads-export.mjs",
    "research:warm": "node scripts/research-warm.mjs",
    "research:sources": "node scripts/research-sources.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@cloudflare/puppeteer": "^1.4.0",
    "@react-pdf/renderer": "^4.9.0",
    "motion": "^13.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  }
}
